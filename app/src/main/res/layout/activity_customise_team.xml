<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.25"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnPrev"
                    style="@style/BarButton.Yellow"
                    android:layout_width="44dp"
                    android:minWidth="0dp"
                    android:paddingStart="0dp"
                    android:paddingEnd="0dp"
                    android:text="&#8249;" />

                <Spinner
                    android:id="@+id/spinnerClub"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:id="@+id/btnNext"
                    style="@style/BarButton.Yellow"
                    android:layout_width="44dp"
                    android:minWidth="0dp"
                    android:paddingStart="0dp"
                    android:paddingEnd="0dp"
                    android:text="&#8250;" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tabUniform"
                    style="@style/TabLabel"
                    android:text="@string/customise_tab_uniform" />

                <TextView
                    android:id="@+id/tabLogo"
                    style="@style/TabLabel"
                    android:text="@string/customise_tab_logo" />
            </LinearLayout>

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="@drawable/bg_panel_light"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/panel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp" />
            </ScrollView>
        </LinearLayout>

        <com.tablehockey.game.ui.TeamPreviewView
            android:id="@+id/preview"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="16dp" />
    </LinearLayout>

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="10dp"
        android:paddingBottom="10dp">

        <TextView
            android:id="@+id/btnCancel"
            style="@style/BarButton.Red"
            android:layout_alignParentStart="true"
            android:text="@string/customise_cancel" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnFav"
                style="@style/MenuTile"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginBottom="0dp"
                android:layout_marginEnd="10dp"
                android:drawableEnd="@null" />

            <TextView
                android:id="@+id/btnReset"
                style="@style/MenuTile"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginBottom="0dp"
                android:drawableEnd="@null"
                android:text="@string/customise_reset" />
        </LinearLayout>

        <TextView
            android:id="@+id/btnConfirm"
            style="@style/BarButton.Yellow"
            android:layout_alignParentEnd="true"
            android:text="@string/customise_confirm" />
    </RelativeLayout>
</LinearLayout>
