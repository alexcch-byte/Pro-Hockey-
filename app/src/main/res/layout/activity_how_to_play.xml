<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/htp_title"
                android:textColor="@color/text_primary"
                android:textSize="28sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnDone"
                style="@style/MenuButton"
                android:layout_width="160dp"
                android:layout_height="48dp"
                android:backgroundTint="@color/accent_red"
                android:text="@string/htp_done" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <!-- Diagram of the touch layout -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginEnd="10dp">

                <com.tablehockey.game.ControlsDiagramView
                    android:layout_width="match_parent"
                    android:layout_height="270dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center"
                    android:text="@string/htp_tip"
                    android:textColor="@color/text_secondary"
                    android:textSize="15sp" />
            </LinearLayout>

            <!-- Explanations -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.15"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:padding="14dp"
                android:layout_marginStart="10dp">

                <LinearLayout style="@style/HelpRow">
                    <TextView style="@style/HelpChip" android:backgroundTint="#16A34A" android:text="@string/htp_skate" />
                    <TextView style="@style/HelpBody" android:text="@string/htp_skate_body" />
                </LinearLayout>

                <LinearLayout style="@style/HelpRow">
                    <TextView style="@style/HelpChip" android:backgroundTint="#DC2626" android:text="@string/htp_shoot" />
                    <TextView style="@style/HelpBody" android:text="@string/htp_shoot_body" />
                </LinearLayout>

                <LinearLayout style="@style/HelpRow">
                    <TextView style="@style/HelpChip" android:backgroundTint="#2563EB" android:text="@string/htp_pass" />
                    <TextView style="@style/HelpBody" android:text="@string/htp_pass_body" />
                </LinearLayout>

                <LinearLayout style="@style/HelpRow">
                    <TextView style="@style/HelpChip" android:backgroundTint="#D97706" android:text="@string/htp_hit" />
                    <TextView style="@style/HelpBody" android:text="@string/htp_hit_body" />
                </LinearLayout>

                <LinearLayout style="@style/HelpRow">
                    <TextView style="@style/HelpChip" android:backgroundTint="#475569" android:text="@string/htp_rules" />
                    <TextView style="@style/HelpBody" android:text="@string/htp_rules_body" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
