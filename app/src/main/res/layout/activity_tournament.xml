<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp">

    <!-- Top Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <Button
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:background="@drawable/bg_card"
            android:text="← Back"
            android:textColor="@color/text_primary"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PLAYOFF CHAMPIONSHIP"
                android:textColor="@color/text_primary"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvTournamentStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Single-Elimination 8-Team Bracket"
                android:textColor="#F59E0B"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <Button
            android:id="@+id/btnReset"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:text="Reset"
            android:textColor="#EF4444"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Setup View (Visible when no active tournament) -->
    <LinearLayout
        android:id="@+id/layoutSetup"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="480dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="NEW TOURNAMENT SETUP"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="16dp" />

            <TextView
                style="@style/SectionLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SELECT YOUR CLUB" />

            <Spinner
                android:id="@+id/spinnerSetupTeam"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="24dp" />

            <Button
                android:id="@+id/btnStartTournament"
                style="@style/MenuButton"
                android:layout_width="match_parent"
                android:text="START PLAYOFFS" />
        </LinearLayout>
    </LinearLayout>

    <!-- Bracket View (Visible when tournament active) -->
    <HorizontalScrollView
        android:id="@+id/layoutBracket"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Quarterfinals Column -->
            <LinearLayout
                android:layout_width="230dp"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:padding="6dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="QUARTERFINALS"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:layout_marginBottom="6dp" />

                <include android:id="@+id/cardQf0" layout="@layout/item_bracket_match" />
                <include android:id="@+id/cardQf1" layout="@layout/item_bracket_match" />
                <include android:id="@+id/cardQf2" layout="@layout/item_bracket_match" />
                <include android:id="@+id/cardQf3" layout="@layout/item_bracket_match" />
            </LinearLayout>

            <View
                android:layout_width="20dp"
                android:layout_height="1dp"
                android:background="#334155" />

            <!-- Semifinals Column -->
            <LinearLayout
                android:layout_width="230dp"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center_vertical"
                android:padding="6dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="SEMIFINALS"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:layout_marginBottom="6dp" />

                <include android:id="@+id/cardSf0" layout="@layout/item_bracket_match" />
                <Space android:layout_width="match_parent" android:layout_height="32dp" />
                <include android:id="@+id/cardSf1" layout="@layout/item_bracket_match" />
            </LinearLayout>

            <View
                android:layout_width="20dp"
                android:layout_height="1dp"
                android:background="#334155" />

            <!-- Finals Column -->
            <LinearLayout
                android:layout_width="230dp"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center_vertical"
                android:padding="6dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="CHAMPIONSHIP FINAL"
                    android:textColor="#F59E0B"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:layout_marginBottom="6dp" />

                <include android:id="@+id/cardFinal" layout="@layout/item_bracket_match" />

                <LinearLayout
                    android:id="@+id/layoutTrophy"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:layout_marginTop="16dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🏆"
                        android:textSize="48sp" />

                    <TextView
                        android:id="@+id/tvChampionName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="CHAMPION!"
                        android:textColor="#FBBF24"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Bottom Action Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="8dp">

        <TextView
            android:id="@+id/tvMatchPrompt"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Ready for Quarterfinals"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnPlayMatch"
            style="@style/MenuButton"
            android:layout_width="240dp"
            android:layout_height="44dp"
            android:text="PLAY NEXT MATCH" />
    </LinearLayout>

</LinearLayout>
