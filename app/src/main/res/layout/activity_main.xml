<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:orientation="horizontal"
    android:gravity="center"
    android:padding="32dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1.1"
        android:orientation="vertical"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="@color/text_primary"
            android:textSize="44sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/menu_tagline"
            android:textColor="@color/text_secondary"
            android:textSize="16sp" />

        <View
            android:layout_width="120dp"
            android:layout_height="4dp"
            android:layout_marginTop="20dp"
            android:background="@color/accent_red" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="24dp">

        <Button
            android:id="@+id/btnPlayNow"
            style="@style/MenuButton"
            android:text="@string/menu_play_now" />

        <Space android:layout_width="0dp" android:layout_height="12dp" />

        <Button
            android:id="@+id/btnWifi2p"
            style="@style/MenuButton"
            android:text="@string/menu_wifi_2p" />

        <Space android:layout_width="0dp" android:layout_height="12dp" />

        <Button
            android:id="@+id/btnHowToPlay"
            style="@style/MenuButton"
            android:text="@string/menu_how_to_play" />

        <Space android:layout_width="0dp" android:layout_height="12dp" />

        <Button
            android:id="@+id/btnExit"
            style="@style/MenuButton"
            android:text="@string/menu_exit" />
    </LinearLayout>

</LinearLayout>
