<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark">

    <com.tablehockey.game.ui.MenuBackdropView
        android:id="@+id/backdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:paddingStart="32dp"
        android:paddingEnd="32dp"
        android:paddingTop="20dp"
        android:paddingBottom="20dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.15"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/menu_title_top"
                android:textColor="@color/text_primary"
                android:textSize="54sp"
                android:textStyle="bold|italic"
                android:fontFamily="sans-serif-condensed"
                android:letterSpacing="0.03"
                android:includeFontPadding="false"
                android:shadowColor="#000000"
                android:shadowDx="0"
                android:shadowDy="4"
                android:shadowRadius="6" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="2dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@color/hx_yellow"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="@string/menu_hockey"
                    android:textColor="@color/hx_ink"
                    android:textSize="30sp"
                    android:textStyle="bold|italic"
                    android:fontFamily="sans-serif-condensed"
                    android:letterSpacing="0.18"
                    android:includeFontPadding="false" />

                <View
                    android:layout_width="40dp"
                    android:layout_height="6dp"
                    android:layout_marginStart="10dp"
                    android:background="@color/hx_red" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/menu_tagline"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:fontFamily="sans-serif-condensed"
                android:shadowColor="#000000"
                android:shadowDx="0"
                android:shadowDy="2"
                android:shadowRadius="4" />

            <TextView
                android:id="@+id/txtClub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="#99061018"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:textColor="@color/hx_yellow"
                android:textSize="14sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-condensed"
                android:textAllCaps="true"
                android:letterSpacing="0.08" />
        </LinearLayout>

        <ScrollView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="24dp"
            android:fillViewport="true"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="0dp"
                android:orientation="vertical"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/btnPlayNow"
                    style="@style/MenuTile.Primary"
                    android:text="@string/menu_play_now" />

                <TextView
                    android:id="@+id/btnTournament"
                    style="@style/MenuTile"
                    android:text="@string/menu_tournament" />

                <TextView
                    android:id="@+id/btnShootout"
                    style="@style/MenuTile"
                    android:text="@string/menu_shootout" />

                <TextView
                    android:id="@+id/btnWifi2p"
                    style="@style/MenuTile"
                    android:text="@string/menu_wifi_2p" />

                <TextView
                    android:id="@+id/btnCustomise"
                    style="@style/MenuTile"
                    android:text="@string/menu_customise" />

                <TextView
                    android:id="@+id/btnHowToPlay"
                    style="@style/MenuTile"
                    android:text="@string/menu_how_to_play" />

                <TextView
                    android:id="@+id/btnExit"
                    style="@style/MenuTile"
                    android:text="@string/menu_exit" />
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</FrameLayout>
