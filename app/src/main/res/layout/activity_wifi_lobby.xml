<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="14dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/mp_title"
                android:textColor="@color/text_primary"
                android:textSize="26sp"
                android:textStyle="bold" />

            <!-- Connection type -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_card"
                android:paddingStart="14dp"
                android:paddingEnd="8dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp">

                <TextView style="@style/SectionLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/mp_connection" android:layout_marginEnd="8dp" />

                <RadioGroup
                    android:id="@+id/radioConnection"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <RadioButton android:id="@+id/connWifi" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/mp_wifi" android:textColor="@color/text_primary" android:checked="true" />
                    <RadioButton android:id="@+id/connBluetooth" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="@string/mp_bluetooth" android:textColor="@color/text_primary" />
                    <RadioButton android:id="@+id/connInternet" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="@string/mp_internet" android:textColor="@color/text_primary" />
                </RadioGroup>
            </LinearLayout>
        </LinearLayout>

        <!-- Chooser -->
        <LinearLayout
            android:id="@+id/chooserLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button android:id="@+id/btnHostGame" style="@style/MenuButton" android:layout_width="0dp" android:layout_weight="1" android:layout_marginEnd="8dp" android:text="@string/wifi_host" />
            <Button android:id="@+id/btnJoinGame" style="@style/MenuButton" android:layout_width="0dp" android:layout_weight="1" android:layout_marginStart="8dp" android:text="@string/wifi_join" />
        </LinearLayout>

        <!-- Host panel -->
        <LinearLayout
            android:id="@+id/hostLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:background="@drawable/bg_card"
                    android:padding="14dp"
                    android:layout_marginEnd="8dp">
                    <TextView style="@style/SectionLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/wifi_host_team" />
                    <Spinner android:id="@+id/spinnerHostTeam" android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="6dp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:background="@drawable/bg_card"
                    android:padding="14dp"
                    android:layout_marginStart="8dp">
                    <TextView style="@style/SectionLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/wifi_guest_team" />
                    <Spinner android:id="@+id/spinnerGuestTeam" android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="6dp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:padding="14dp"
                android:layout_marginTop="12dp">

                <TextView style="@style/SectionLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/settings_period_length" />

                <RadioGroup
                    android:id="@+id/radioHostPeriod"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="6dp">
                    <RadioButton android:id="@+id/hostPeriod1" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/period_1" android:textColor="@color/text_primary" />
                    <RadioButton android:id="@+id/hostPeriod2" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/period_2" android:textColor="@color/text_primary" android:checked="true" />
                    <RadioButton android:id="@+id/hostPeriod3" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/period_3" android:textColor="@color/text_primary" />
                    <RadioButton android:id="@+id/hostPeriod5" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/period_5" android:textColor="@color/text_primary" />
                </RadioGroup>
            </LinearLayout>

            <TextView
                android:id="@+id/hostHintText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/bt_hint_host"
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/hostRoomCodeText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_card"
                android:padding="14dp"
                android:gravity="center"
                android:textColor="@color/text_primary"
                android:textSize="34sp"
                android:textStyle="bold"
                android:letterSpacing="0.2"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="12dp">
                <Button android:id="@+id/btnStartHosting" style="@style/MenuButton" android:layout_width="0dp" android:layout_weight="1" android:layout_marginEnd="8dp" android:text="@string/wifi_host" />
                <Button android:id="@+id/btnDiscoverable" style="@style/MenuButton" android:layout_width="0dp" android:layout_weight="1" android:layout_marginEnd="8dp" android:text="@string/bt_make_discoverable" android:visibility="gone" />
                <Button android:id="@+id/btnCancelHost" style="@style/MenuButton" android:layout_width="0dp" android:layout_weight="1" android:backgroundTint="@color/accent_red" android:text="@string/wifi_cancel" />
            </LinearLayout>

            <TextView
                android:id="@+id/hostStatusText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:textColor="@color/text_secondary"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Join panel -->
        <LinearLayout
            android:id="@+id/joinLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/joinHintText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/wifi_hint_join"
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/joinStatusText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="@color/text_primary"
                android:textStyle="bold"
                android:text="@string/wifi_searching_status"
                android:layout_marginBottom="10dp" />

            <LinearLayout
                android:id="@+id/discoveredListContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <Button
                android:id="@+id/btnScan"
                style="@style/MenuButton"
                android:layout_marginTop="12dp"
                android:text="@string/bt_scan"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/manualIpRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="14dp">

                <TextView
                    style="@style/SectionLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/wifi_manual_ip_hint" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="6dp">

                    <EditText
                        android:id="@+id/editHostIp"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:inputType="textUri"
                        android:hint="192.168.1.10"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_secondary" />

                    <Button
                        android:id="@+id/btnConnectIp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/wifi_connect_button" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/manualCodeRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="14dp"
                android:visibility="gone">

                <TextView
                    style="@style/SectionLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/internet_room_code_hint" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="6dp">

                    <EditText
                        android:id="@+id/editRoomCode"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:inputType="textCapCharacters"
                        android:maxLength="8"
                        android:hint="ABCDE"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_secondary" />

                    <Button
                        android:id="@+id/btnConnectCode"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/wifi_connect_button" />
                </LinearLayout>
            </LinearLayout>

            <Button
                android:id="@+id/btnCancelJoin"
                style="@style/MenuButton"
                android:layout_marginTop="16dp"
                android:backgroundTint="@color/accent_red"
                android:text="@string/wifi_cancel" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
